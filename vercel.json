{
  "headers": [
    { "source": "/(.*)", "headers": [
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
    ] },
    { "source": "/(config.js|app.js|cloud.js|slipreader.js)", "headers": [ { "key": "Cache-Control", "value": "no-cache" } ] }
  ]
}
